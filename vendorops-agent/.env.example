# Copy to .env and fill in real values. Do not commit .env.
# Keys Generated from AWS Console https://us-east-1.console.aws.amazon.com/iam/home?region=us-east-1#/users -> Click on the user and then click on the Security Credentials tab -> Click on the Access keys for CLI and API access -> Click on the Create access key -> Download the access key and secret access key -> Copy the access key ID and secret access key to the .env fileY
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
