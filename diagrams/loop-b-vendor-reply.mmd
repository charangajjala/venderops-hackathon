flowchart TD
    Start(["Vendor replies\nto the RFQ email"])
    SES["SES receipt rule"]
    S3[("S3: raw MIME")]
    SNS["SNS"]
    SQS["SQS + DLQ"]
    Svc["Service Lambda"]
    Dup{"Already processed\nthis message-id?\n(Idempotency table)"}
    SkipDup(["Skip - duplicate delivery"])
    Parse["fetch raw MIME from S3,\nparse body, correlate RFQ id"]
    Invoke["invoke AgentCore Runtime"]
    GetRFQ["agent: get_rfq + get_vendor"]
    Record["agent: record_quote\n(price, qty, lead time, MOQ)"]
    Trust{"Vendor trusted AND\nquote complete?"}
    IssuePO["agent: create_purchase_order\nPO issued, RFQ awarded,\nInventory restocked"]
    ConfirmEmail(["SES sends PO\nconfirmation to vendor"])
    Notify["agent: notify_buyer\n(escalation email)"]
    Dashboard["Human reviews the RFQ\non the dashboard"]
    Decide(["Approve or Reject\n(dashboard button)"])
    ReplyEmail(["Service Lambda sends\nthe agent's reply via SES"])
    MarkDone["mark message-id processed"]

    Start --> SES
    SES --> S3
    SES --> SNS --> SQS --> Svc
    Svc --> Dup
    Dup -- yes --> SkipDup
    Dup -- no --> Parse --> Invoke --> GetRFQ --> Record --> Trust
    Trust -- yes --> IssuePO --> ConfirmEmail
    Trust -- no --> Notify --> Dashboard --> Decide
    ConfirmEmail --> ReplyEmail
    Decide --> ReplyEmail
    ReplyEmail --> MarkDone

    classDef terminal fill:#1b2735,stroke:#4f8cff,color:#e6e8eb;
    classDef decision fill:#2a1f14,stroke:#e3b341,color:#e6e8eb;
    classDef compute fill:#161b22,stroke:#3fb950,color:#e6e8eb;
    classDef store fill:#1b2735,stroke:#4f8cff,color:#e6e8eb;
    class Start,SkipDup,ConfirmEmail,Decide,ReplyEmail terminal;
    class Dup,Trust decision;
    class SES,SNS,SQS,Svc,Parse,Invoke,GetRFQ,Record,IssuePO,Notify,Dashboard,MarkDone compute;
    class S3 store;
