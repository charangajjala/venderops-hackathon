# AWS auth for `make docker-run-local`.
#
# Preferred: don't fill in this file at all. Export AWS_PROFILE and AWS_REGION
# in your shell before running `make docker-run-local` (e.g.
# `export AWS_PROFILE=AgentsForHumans AWS_REGION=us-east-1`) - docker-compose.yml
# mounts your host ~/.aws read-only into the container and passes AWS_PROFILE
# through, so the container reuses your existing SSO session. No secret ever
# touches a file.
#
# Fallback: if you don't have an SSO profile, copy this file to .env and fill
# in static IAM-user keys instead. .env is gitignored, but these are
# long-lived credentials sitting in a plaintext file - prefer the profile
# approach above when you can.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
